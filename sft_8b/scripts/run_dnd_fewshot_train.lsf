#!/bin/bash
#BSUB -J dnd_fewshot_train
#BSUB -P acc_lin_lab
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 08:00
#BSUB -o /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/dnd_transfer/lsf/fewshot_train.%J.out
#BSUB -e /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/dnd_transfer/lsf/fewshot_train.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/sc/arion/projects/lin_lab/complexbehavior/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge/etc/profile.d/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY=/sc/arion/work/cuiz02/conda-envs/envs/casino/bin/python
export HF_HOME=/sc/arion/scratch/cuiz02/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-opponent_model/results/dnd_transfer}"
BASE_MODEL="${BASE_MODEL:-/sc/arion/scratch/cuiz02/hf_cache/transformers/Meta-Llama-3.1-8B-Instruct}"
DATA_OUT="${DATA_OUT:-$ROOT/sft_data/fewshot_opponent}"
TRAIN_OUT="${TRAIN_OUT:-$ROOT/fewshot_lora}"
mkdir -p "$ROOT/lsf" "$DATA_OUT" "$TRAIN_OUT"

echo "=== DND few-shot train job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

"$CASINO_PY" -m sft_8b.build_dnd_sft_data \
  --output-dir "$DATA_OUT" \
  --raw-dir "$ROOT/data/raw" \
  --n-dialogues 50 \
  --seed 42 \
  --eval-fraction 0.10

"$CASINO_PY" -m sft_8b.train \
  --base-model "$BASE_MODEL" \
  --train-file "$DATA_OUT/combined_train_rows.jsonl" \
  --eval-file "$DATA_OUT/combined_eval_rows.jsonl" \
  --output-dir "$TRAIN_OUT" \
  --num-train-epochs 3 \
  --max-seq-length 1536 \
  --per-device-train-batch-size 4 \
  --per-device-eval-batch-size 4 \
  --gradient-accumulation-steps 4

echo "=== done at $(date) ==="
