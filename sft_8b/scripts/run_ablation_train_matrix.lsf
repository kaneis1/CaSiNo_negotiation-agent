#!/bin/bash
#BSUB -J ab_train[1-5]%2
#BSUB -P acc_lin_lab
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 08:00
#BSUB -o /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/ablation_neurips2026/lsf/train.%I.%J.out
#BSUB -e /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/ablation_neurips2026/lsf/train.%I.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/sc/arion/projects/lin_lab/complexbehavior/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge/etc/profile.d/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY=/sc/arion/work/cuiz02/conda-envs/envs/casino/bin/python
export HF_HOME=/sc/arion/scratch/cuiz02/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-opponent_model/results/ablation_neurips2026}"
BASE_MODEL="${BASE_MODEL:-/sc/arion/scratch/cuiz02/hf_cache/transformers/Meta-Llama-3.1-8B-Instruct}"
SOURCE_JSONL="${SOURCE_JSONL:-sft_8b/results/distill/day7/day7_distill.jsonl}"
TRAIN_DIALOGUES="${TRAIN_DIALOGUES:-data/casino_train.json}"
TASK="${TASK:-1}"
if [[ "${LSB_JOBINDEX:-}" =~ ^[1-9][0-9]*$ ]]; then
    TASK="$LSB_JOBINDEX"
fi
mkdir -p "$ROOT/lsf"

case "$TASK" in
  1) VARIANT="direct_posterior_groundtruth" ;;
  2) VARIANT="direct_posterior_teacher" ;;
  3) VARIANT="action_only" ;;
  4) VARIANT="map_only" ;;
  5) VARIANT="reversed" ;;
  *) echo "unknown TASK=$TASK" >&2; exit 2 ;;
esac

DATA_OUT="$ROOT/sft_data/$VARIANT"
TRAIN_OUT="$ROOT/lora/$VARIANT"

echo "=== ablation train $VARIANT task $TASK job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
echo "DATA_OUT=$DATA_OUT"
echo "TRAIN_OUT=$TRAIN_OUT"
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

"$CASINO_PY" -m sft_8b.build_ablation_sft_data \
  --variant "$VARIANT" \
  --input-jsonl "$SOURCE_JSONL" \
  --dialogues "$TRAIN_DIALOGUES" \
  --output-dir "$DATA_OUT" \
  --eval-fraction 0.10 \
  --seed 42

"$CASINO_PY" -m sft_8b.train \
  --base-model "$BASE_MODEL" \
  --train-file "$DATA_OUT/${VARIANT}_train_rows.jsonl" \
  --eval-file "$DATA_OUT/${VARIANT}_eval_rows.jsonl" \
  --output-dir "$TRAIN_OUT" \
  --num-train-epochs 3 \
  --max-seq-length 1536 \
  --per-device-train-batch-size 4 \
  --per-device-eval-batch-size 4 \
  --gradient-accumulation-steps 4

echo "=== done at $(date) ==="
