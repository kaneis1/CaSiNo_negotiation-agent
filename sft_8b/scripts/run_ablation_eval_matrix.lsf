#!/bin/bash
#BSUB -J ab_eval[1-22]%2
#BSUB -P acc_lin_lab
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 06:00
#BSUB -o /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/ablation_neurips2026/lsf/eval.%I.%J.out
#BSUB -e /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/ablation_neurips2026/lsf/eval.%I.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/sc/arion/projects/lin_lab/complexbehavior/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge/etc/profile.d/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY=/sc/arion/work/cuiz02/conda-envs/envs/casino/bin/python
export HF_HOME=/sc/arion/scratch/cuiz02/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-opponent_model/results/ablation_neurips2026}"
DATA="${DATA:-data/casino_test.json}"
ANNOTATIONS="${ANNOTATIONS:-CaSiNo/data/casino_ann.json}"
BASE_MODEL="${BASE_MODEL:-/sc/arion/scratch/cuiz02/hf_cache/transformers/Meta-Llama-3.1-8B-Instruct}"
TEACHER_ADAPTER="${TEACHER_ADAPTER:-sft_8b/results/lora_run/lora_best}"
STUDENT_ADAPTER="${STUDENT_ADAPTER:-sft_8b/results/day8_lora_run/lora_best}"
DIRECT_GT_ADAPTER="${DIRECT_GT_ADAPTER:-$ROOT/lora/direct_posterior_groundtruth/lora_best}"
DIRECT_TEACHER_ADAPTER="${DIRECT_TEACHER_ADAPTER:-$ROOT/lora/direct_posterior_teacher/lora_best}"
ACTION_ONLY_ADAPTER="${ACTION_ONLY_ADAPTER:-$ROOT/lora/action_only/lora_best}"
MAP_ONLY_ADAPTER="${MAP_ONLY_ADAPTER:-$ROOT/lora/map_only/lora_best}"
REVERSED_ADAPTER="${REVERSED_ADAPTER:-$ROOT/lora/reversed/lora_best}"
MAX_DIALOGUES="${MAX_DIALOGUES:-150}"
PERSPECTIVES="${PERSPECTIVES:-mturk_agent_1}"
TASK="${TASK:-1}"
if [[ "${LSB_JOBINDEX:-}" =~ ^[1-9][0-9]*$ ]]; then
    TASK="$LSB_JOBINDEX"
fi

mkdir -p "$ROOT/lsf"

echo "=== ablation eval task $TASK job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

run_teacher () {
  local name="$1"; shift
  "$CASINO_PY" -m sft_8b.ablation \
    --data "$DATA" --annotations "$ANNOTATIONS" \
    --output-dir "$ROOT/$name" \
    --base-model "$BASE_MODEL" --adapter "$TEACHER_ADAPTER" \
    --max-dialogues "$MAX_DIALOGUES" --perspectives "$PERSPECTIVES" \
    "$@"
}

run_student () {
  local name="$1"; shift
  "$CASINO_PY" -m sft_8b.ablation_student \
    --data "$DATA" --annotations "$ANNOTATIONS" \
    --output-dir "$ROOT/$name" \
    --base-model "$BASE_MODEL" --adapter "$STUDENT_ADAPTER" \
    --max-dialogues "$MAX_DIALOGUES" --perspectives "$PERSPECTIVES" \
    "$@"
}

case "$TASK" in
  1)  run_teacher "a1_mc_k16_full_context" --provider mc_k16_full_context --evidence-mode utterance_only ;;
  2)  run_teacher "a1_mc_k1_full_context" --provider mc_k1_full_context --evidence-mode utterance_only ;;
  3)  run_teacher "a1a_direct_zero_shot" --provider direct_zero_shot --evidence-mode utterance_only ;;
  4)  run_teacher "a1b_direct_sft_groundtruth" --provider direct_sft_groundtruth --direct-adapter "$DIRECT_GT_ADAPTER" --evidence-mode utterance_only ;;
  5)  run_teacher "a1b_direct_sft_teacher" --provider direct_sft_teacher --direct-adapter "$DIRECT_TEACHER_ADAPTER" --evidence-mode utterance_only ;;
  6)  run_teacher "a3_rule_likelihood" --provider rule_likelihood --evidence-mode utterance_only ;;
  7)  run_teacher "incremental_bayes_utterance" --provider incremental_bayes_utterance --evidence-mode utterance_only ;;
  8)  run_teacher "a5_uniform_posterior_planner" --provider uniform --evidence-mode utterance_only ;;
  9)  run_teacher "a6_utterance_plus_offers" --provider mc_k16_full_context --evidence-mode utterance_plus_offers ;;
  10) run_teacher "a7_offers_only" --provider mc_k16_full_context --evidence-mode offers_only ;;
  11) run_teacher "a6b_preference_utterances_only_annotated" --provider mc_k16_full_context --evidence-mode preference_utterances_only --annotated-only ;;
  12) run_teacher "a6b_nonpreference_utterances_only_annotated" --provider mc_k16_full_context --evidence-mode nonpreference_utterances_only --annotated-only ;;
  13) run_student "a4_full_student" --schema full --prefix-mode none ;;
  14) run_student "a2d_sanity_emitted_prefix" --schema full --prefix-mode emitted --sanity-compare-prefix ;;
  15) run_student "a2d_adversarial_prefix" --schema full --prefix-mode adversarial --sanity-compare-prefix ;;
  16) run_student "a2d_uniform_prefix" --schema full --prefix-mode uniform --sanity-compare-prefix ;;
  17) run_student "a2d_correct_prefix" --schema full --prefix-mode correct --sanity-compare-prefix ;;
  18) STUDENT_ADAPTER="$ACTION_ONLY_ADAPTER"; run_student "a4_action_only_student" --schema action_only --prefix-mode none ;;
  19) STUDENT_ADAPTER="$MAP_ONLY_ADAPTER"; run_student "a4_map_only_student" --schema map_only --prefix-mode none ;;
  20) STUDENT_ADAPTER="$REVERSED_ADAPTER"; run_student "a4_reversed_student" --schema reversed --prefix-mode none ;;
  21) run_teacher "a10_lambda_0" --provider mc_k16_full_context --evidence-mode utterance_only --lambda 0.0 ;;
  22) run_teacher "a10_lambda_0_5" --provider mc_k16_full_context --evidence-mode utterance_only --lambda 0.5 ;;
  *) echo "unknown TASK=$TASK" >&2; exit 2 ;;
esac

echo "=== done at $(date) ==="
