#!/bin/bash
#BSUB -J dnd_rule
#BSUB -P acc_lin_lab
#BSUB -q premium
#BSUB -R "rusage[mem=20G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 02:00
#BSUB -o /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/dnd_transfer/lsf/rule.%J.out
#BSUB -e /sc/arion/projects/lin_lab/complexbehavior/CaSino/opponent_model/results/dnd_transfer/lsf/rule.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/sc/arion/projects/lin_lab/complexbehavior/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge/etc/profile.d/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY=/sc/arion/work/cuiz02/conda-envs/envs/casino/bin/python
ROOT="${ROOT:-opponent_model/results/dnd_transfer}"
mkdir -p "$ROOT/lsf"

"$CASINO_PY" -m sft_8b.dnd_eval \
  --provider rule \
  --name-mode native \
  --value-mode 543 \
  --raw-dir "$ROOT/data/raw" \
  --output-dir "$ROOT/eval_rule_baseline"
