#!/bin/bash
#BSUB -J cot_p3_70b
#BSUB -P anonymous_project
#BSUB -q gpu
#BSUB -gpu "num=2"
#BSUB -R "h100nvl rusage[mem=40000] span[hosts=1]"
#BSUB -n 4
#BSUB -W 24:00
#BSUB -o artifacts/training_metadata/lsf/structured_cot/p3_baseline_70b.%J.out
#BSUB -e artifacts/training_metadata/lsf/structured_cot/p3_baseline_70b.%J.err
#BSUB -L /bin/bash

# Protocol 3 baseline: Structured CoT (Llama-3.3-70B-Instruct) evaluated on
# GOLD chat_logs at every mturk_agent_1 turn — matched support with the
# Bayesian teacher's turn_level_eval run (n≈87 accept, n≈86 bid on 150 dlg).
#
# This is NOT a replay of Protocol 1 self-play; it is a fresh LLM call per
# turn so the baseline cannot early-terminate before human decision points.
#
# Submit:
#   bsub < experiments/lsf/structured_cot/run_p3_baseline_70b.lsf
# Override model path:
#   bsub -env "all, MODEL_ID=/path/to/Llama-3.3-70B-Instruct" < ... >
#
# Wallclock: ~1054 forwards × (~40 s) can exceed 12 h on H100; job 239149741
# hit TERM_RUNLIMIT at 12:00 with no turn_summary.json — use -W 24:00.

set -eo pipefail

REPO_ROOT="/path/to/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /path/to/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY="${CASINO_PY:-python}"

export HF_HOME="${HF_HOME:-/path/to/hf_cache}"
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1

MODEL_ID="${MODEL_ID:-}"
OUT="${OUT:-artifacts/results/protocol3/structured_cot_70b_full150}"
DATA="${DATA:-data/casino/casino_test.json}"
ANN="${ANN:-external/casino_original/data/casino_ann.json}"
MAX_DLG="${MAX_DLG:-150}"

mkdir -p artifacts/training_metadata/lsf/structured_cot
mkdir -p "$OUT"

echo "=== job $LSB_JOBID on $(hostname) at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true
echo "OUT=$OUT  DATA=$DATA  MAX_DLG=$MAX_DLG  MODEL_ID=${MODEL_ID:-<default 70B snapshot>}"
echo "========================================================================"

EXTRA=()
if [[ -n "$MODEL_ID" ]]; then
  EXTRA+=(--model-id "$MODEL_ID")
fi

"$CASINO_PY" -m casino_belief.evaluation.turn_eval_run \
    --data             "$DATA" \
    --output-dir       "$OUT" \
    --agent            structured_cot_live \
    "${EXTRA[@]}" \
    --annotations      "$ANN" \
    --perspectives     mturk_agent_1 \
    --max-dialogues    "$MAX_DLG" \
    --max-new-tokens   800 \
    --temperature      0.3 \
    --structured-cot-seed 2024 \
    --structured-cot-parse-log "$OUT/parse_failures.jsonl"

echo "=== done at $(date) ==="
