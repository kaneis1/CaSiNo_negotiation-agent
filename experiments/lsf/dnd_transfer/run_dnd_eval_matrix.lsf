#!/bin/bash
#BSUB -J dnd_eval[1-7]%2
#BSUB -P anonymous_project
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 06:00
#BSUB -o /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/eval.%I.%J.out
#BSUB -e /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/eval.%I.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/path/to/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /path/to/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY="${CASINO_PY:-python}"
export HF_HOME="${HF_HOME:-/path/to/hf_cache}"
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-artifacts/results/dnd_transfer/main}"
BASE_MODEL="${BASE_MODEL:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
TEACHER_ADAPTER="${TEACHER_ADAPTER:-artifacts/training_metadata/teacher_lora_run/lora_best}"
FEWSHOT_ADAPTER="${FEWSHOT_ADAPTER:-$ROOT/fewshot_lora/lora_best}"
TASK="${TASK:-1}"
if [[ "${LSB_JOBINDEX:-}" =~ ^[1-9][0-9]*$ ]]; then
    TASK="$LSB_JOBINDEX"
fi
mkdir -p "$ROOT/lsf"

PROVIDER="mc_k16"
NAME_MODE="native"
VALUE_MODE="543"
ADAPTER="$TEACHER_ADAPTER"
OUT_NAME=""

case "$TASK" in
  1) PROVIDER="direct_zero_shot"; NAME_MODE="native";  VALUE_MODE="543";       ADAPTER="$TEACHER_ADAPTER"; OUT_NAME="eval_direct_zeroshot_native" ;;
  2) PROVIDER="direct_zero_shot"; NAME_MODE="renamed"; VALUE_MODE="543";       ADAPTER="$TEACHER_ADAPTER"; OUT_NAME="eval_direct_zeroshot_renamed" ;;
  3) PROVIDER="mc_k16";           NAME_MODE="native";  VALUE_MODE="543";       ADAPTER="$TEACHER_ADAPTER"; OUT_NAME="eval_zeroshot_native" ;;
  4) PROVIDER="mc_k16";           NAME_MODE="renamed"; VALUE_MODE="543";       ADAPTER="$TEACHER_ADAPTER"; OUT_NAME="eval_zeroshot_renamed" ;;
  5) PROVIDER="mc_k16";           NAME_MODE="renamed"; VALUE_MODE="543";       ADAPTER="$FEWSHOT_ADAPTER"; OUT_NAME="eval_fewshot_renamed_543" ;;
  6) PROVIDER="mc_k16";           NAME_MODE="renamed"; VALUE_MODE="empirical"; ADAPTER="$FEWSHOT_ADAPTER"; OUT_NAME="eval_fewshot_renamed_empirical" ;;
  7) PROVIDER="mc_k16";           NAME_MODE="native";  VALUE_MODE="empirical"; ADAPTER="$FEWSHOT_ADAPTER"; OUT_NAME="eval_fewshot_native_empirical" ;;
  *) echo "unknown TASK=$TASK" >&2; exit 2 ;;
esac

echo "=== DND eval task $TASK $OUT_NAME job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

"$CASINO_PY" -m casino_belief.transfer.dnd.dnd_eval \
  --provider "$PROVIDER" \
  --name-mode "$NAME_MODE" \
  --value-mode "$VALUE_MODE" \
  --raw-dir "$ROOT/data/raw" \
  --output-dir "$ROOT/$OUT_NAME" \
  --base-model "$BASE_MODEL" \
  --adapter "$ADAPTER"

echo "=== done at $(date) ==="
