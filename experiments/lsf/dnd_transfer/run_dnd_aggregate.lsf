#!/bin/bash
#BSUB -J dnd_aggregate
#BSUB -P anonymous_project
#BSUB -q premium
#BSUB -R "rusage[mem=20G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 01:00
#BSUB -o /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/aggregate.%J.out
#BSUB -e /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/aggregate.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/path/to/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /path/to/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY="${CASINO_PY:-python}"
ROOT="${ROOT:-artifacts/results/dnd_transfer/main}"
mkdir -p "$ROOT/lsf"

"$CASINO_PY" -m casino_belief.transfer.dnd.dnd_aggregate --root "$ROOT"
