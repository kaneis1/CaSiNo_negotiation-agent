#!/bin/bash
#BSUB -J dnd_fewshot_train
#BSUB -P anonymous_project
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 08:00
#BSUB -o /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/fewshot_train.%J.out
#BSUB -e /path/to/CaSino/artifacts/results/dnd_transfer/main/lsf/fewshot_train.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/path/to/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /path/to/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY="${CASINO_PY:-python}"
export HF_HOME="${HF_HOME:-/path/to/hf_cache}"
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-artifacts/results/dnd_transfer/main}"
BASE_MODEL="${BASE_MODEL:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
DATA_OUT="${DATA_OUT:-$ROOT/sft_data/fewshot_opponent}"
TRAIN_OUT="${TRAIN_OUT:-$ROOT/fewshot_lora}"
mkdir -p "$ROOT/lsf" "$DATA_OUT" "$TRAIN_OUT"

echo "=== DND few-shot train job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

"$CASINO_PY" -m casino_belief.training.build_dnd_sft_data \
  --output-dir "$DATA_OUT" \
  --raw-dir "$ROOT/data/raw" \
  --n-dialogues 50 \
  --seed 42 \
  --eval-fraction 0.10

"$CASINO_PY" -m casino_belief.training.train \
  --base-model "$BASE_MODEL" \
  --train-file "$DATA_OUT/combined_train_rows.jsonl" \
  --eval-file "$DATA_OUT/combined_eval_rows.jsonl" \
  --output-dir "$TRAIN_OUT" \
  --num-train-epochs 3 \
  --max-seq-length 1536 \
  --per-device-train-batch-size 4 \
  --per-device-eval-batch-size 4 \
  --gradient-accumulation-steps 4

echo "=== done at $(date) ==="
