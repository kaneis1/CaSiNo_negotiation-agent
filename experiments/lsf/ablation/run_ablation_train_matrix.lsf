#!/bin/bash
#BSUB -J ab_train[1-5]%2
#BSUB -P anonymous_project
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=40G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 08:00
#BSUB -o /path/to/CaSino/artifacts/results/ablation/main/lsf/train.%I.%J.out
#BSUB -e /path/to/CaSino/artifacts/results/ablation/main/lsf/train.%I.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/path/to/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /path/to/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY="${CASINO_PY:-python}"
export HF_HOME="${HF_HOME:-/path/to/hf_cache}"
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TRANSFORMERS_NO_ADVISORY_WARNINGS=1

ROOT="${ROOT:-artifacts/results/ablation/main}"
BASE_MODEL="${BASE_MODEL:-meta-llama/Meta-Llama-3.1-8B-Instruct}"
SOURCE_JSONL="${SOURCE_JSONL:-artifacts/training_metadata/distill/day7/day7_distill.jsonl}"
TRAIN_DIALOGUES="${TRAIN_DIALOGUES:-data/casino/casino_train.json}"
TASK="${TASK:-1}"
if [[ "${LSB_JOBINDEX:-}" =~ ^[1-9][0-9]*$ ]]; then
    TASK="$LSB_JOBINDEX"
fi
mkdir -p "$ROOT/lsf"

case "$TASK" in
  1) VARIANT="direct_posterior_groundtruth" ;;
  2) VARIANT="direct_posterior_teacher" ;;
  3) VARIANT="action_only" ;;
  4) VARIANT="map_only" ;;
  5) VARIANT="reversed" ;;
  *) echo "unknown TASK=$TASK" >&2; exit 2 ;;
esac

DATA_OUT="$ROOT/sft_data/$VARIANT"
TRAIN_OUT="$ROOT/lora/$VARIANT"

echo "=== ablation train $VARIANT task $TASK job ${LSB_JOBID:-local} on $(hostname) at $(date) ==="
echo "DATA_OUT=$DATA_OUT"
echo "TRAIN_OUT=$TRAIN_OUT"
nvidia-smi --query-gpu=index,name,memory.total --format=csv || true

"$CASINO_PY" -m casino_belief.training.build_ablation_sft_data \
  --variant "$VARIANT" \
  --input-jsonl "$SOURCE_JSONL" \
  --dialogues "$TRAIN_DIALOGUES" \
  --output-dir "$DATA_OUT" \
  --eval-fraction 0.10 \
  --seed 42

"$CASINO_PY" -m casino_belief.training.train \
  --base-model "$BASE_MODEL" \
  --train-file "$DATA_OUT/${VARIANT}_train_rows.jsonl" \
  --eval-file "$DATA_OUT/${VARIANT}_eval_rows.jsonl" \
  --output-dir "$TRAIN_OUT" \
  --num-train-epochs 3 \
  --max-seq-length 1536 \
  --per-device-train-batch-size 4 \
  --per-device-eval-batch-size 4 \
  --gradient-accumulation-steps 4

echo "=== done at $(date) ==="
