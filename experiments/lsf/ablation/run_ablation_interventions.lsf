#!/bin/bash
#BSUB -J ab_intervene[1-3]
#BSUB -P acc_lin_lab
#BSUB -q gpu
#BSUB -gpu "num=1"
#BSUB -R "h100nvl rusage[mem=20G] span[hosts=1]"
#BSUB -n 1
#BSUB -W 01:00
#BSUB -o /sc/arion/projects/lin_lab/complexbehavior/CaSino/artifacts/results/ablation/main/lsf/intervene.%I.%J.out
#BSUB -e /sc/arion/projects/lin_lab/complexbehavior/CaSino/artifacts/results/ablation/main/lsf/intervene.%I.%J.err
#BSUB -L /bin/bash

set -eo pipefail

REPO_ROOT="/sc/arion/projects/lin_lab/complexbehavior/CaSino"
cd "$REPO_ROOT"

unset PYTHONPATH
set +u
source /hpc/packages/minerva-rocky9/miniforge3/26.1.1-3/miniforge/etc/profile.d/conda.sh
conda activate casino
set -u
hash -r

CASINO_PY=/sc/arion/work/cuiz02/conda-envs/envs/casino/bin/python
ROOT="${ROOT:-artifacts/results/ablation/main}"
DATA="${DATA:-data/casino/casino_test.json}"
RECORDS="${RECORDS:-$ROOT/a4_full_student/turn_records.jsonl}"
TASK="${TASK:-1}"
if [[ "${LSB_JOBINDEX:-}" =~ ^[1-9][0-9]*$ ]]; then
    TASK="$LSB_JOBINDEX"
fi
mkdir -p "$ROOT/lsf" "$ROOT/a2_interventions"

case "$TASK" in
  1) MODE="adversarial" ;;
  2) MODE="uniform" ;;
  3) MODE="random" ;;
  *) echo "unknown TASK=$TASK" >&2; exit 2 ;;
esac

"$CASINO_PY" -m casino_belief.diagnostics.ablation.ablation_interventions \
  --records "$RECORDS" \
  --data "$DATA" \
  --mode "$MODE" \
  --output "$ROOT/a2_interventions/${MODE}_intervention.json"
