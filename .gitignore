# Python / local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local environments and editor noise
.env
.env.*
.venv/
venv/
env/
.DS_Store
.idea/
.vscode/

# Logs and scheduler output
*.log
*.out
*.err
/lsf/

# Model weights, trainer state, and binary caches
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.gguf
checkpoint-*/
**/checkpoint-*/
wandb/
runs/

# Paper-result artifacts generated by experiments.
# Keep paper_artifacts/ tracked as the lightweight reviewer overlay; the
# large source outputs under artifacts/ stay local/reproducible.
/artifacts/

# Raw/derived corpora that are too large or externally sourced for GitHub.
# Keep small notes/manifests in data/ trackable, but leave bulky examples local.
/data/*.json
/data/casino/*.json
/data/dnd/*.json
/data/dnd/*.jsonl
/data/dnd/raw/*.txt

# Imported external repositories/baselines; keep provenance in paper_artifacts.
/external/

# Historical roots from the pre-reorganization layout. These should not be
# resurrected accidentally after the src/casino_belief migration.
/SFT/checkpoints/
/sft_8b/results/
/opponent_model/results/
/structured_cot/results/
/prompt_engineer.egg-info/

# Local scratch/database caches
*.sqlite
*.sqlite3
*.db
